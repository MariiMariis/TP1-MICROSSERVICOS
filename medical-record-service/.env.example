# Copie para .env e preencha. O arquivo .env NAO e versionado.

# Connection string do MongoDB Atlas (Database > Connect > Drivers > Node.js).
# Ex.: mongodb+srv://usuario:senha@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://medflow:medflow@localhost:27017/?authSource=admin

# Database usado pelo servico (criado automaticamente na primeira escrita).
MONGODB_DB=medflow_medical_records

# Porta HTTP do servico (mesma porta da Entrega 1).
PORT=8083

# Registro no Eureka (discovery-server). Coloque false para subir sem o Eureka.
EUREKA_ENABLED=true
EUREKA_SERVICE_URL=http://localhost:8761/eureka/
# IP anunciado no Eureka. Vazio = detecta o IP da rede local (mesmo comportamento do prefer-ip-address dos servicos Java).
EUREKA_INSTANCE_IP=

# Popula o banco com os 120 pacientes se as colecoes estiverem vazias.
SEED_ON_STARTUP=true
