    "seed:force": "node src/seed/run-seed.js --force"
  },
  "dependencies": {
    "bson": "^6.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "mongodb": "^6.17.0"
  }
}
