{
  "name": "medical-record-service",
  "version": "2.0.0",
  "description": "MedFlow - Prontuario eletronico (MongoDB Atlas). Microservice em Node.js registrado no Eureka.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
